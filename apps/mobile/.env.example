# Address of the CommunityCare API as seen from the phone or simulator.
# iOS Simulator on the same Mac can reach Herd's .test domain; Android emulators and
# real phones need your Mac's LAN address or a tunnel (see docs/local-development.md).
EXPO_PUBLIC_API_URL=http://communitycare-api.test

# Live notifications while the app is open (Laravel Reverb). Values from apps/api/.env.
# The app key is public by design; the secret stays on the server.
EXPO_PUBLIC_REVERB_KEY=
EXPO_PUBLIC_REVERB_HOST=localhost
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http

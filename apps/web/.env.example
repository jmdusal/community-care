# Real-time notifications (Laravel Reverb). Copy to .env.local and use the values
# from apps/api/.env (REVERB_APP_KEY, REVERB_HOST, REVERB_PORT, REVERB_SCHEME).
# The app key is public by design; the secret stays on the server.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

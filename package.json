{
  "name": "communitycare-ai",
  "private": true,
  "description": "CommunityCare AI monorepo: Laravel API (apps/api), React web (apps/web), shared packages.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @communitycare/web",
    "build:web": "npm run build -w @communitycare/web",
    "test:web": "npm run test -w @communitycare/web",
    "typecheck:web": "npm run typecheck -w @communitycare/web"
  }
}
